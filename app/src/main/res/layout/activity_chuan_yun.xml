<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".chuanyun.ChuanYunActivity">

    <ScrollView
        android:layout_width="192dp"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_set_socket"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Set Socket"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_set_serial"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Set Serial"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_connect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="connect"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_disconnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="disconnect"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_read_status"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="read status"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_read_sbus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="read sbus"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_write_sbus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="write sbus"
                android:textSize="12sp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/purple_700"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="rf hard switch"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btn_read_rf_config"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="read RFConfig"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_set_work_mode_7"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="set work mode 7"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_dev_mac"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:hint="DevMac"
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_write_dev_mac"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="write"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_rf_power_fix_2"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:hint="2G"
                        android:inputType="number"
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=","
                        android:textColor="@android:color/white" />

                    <EditText
                        android:id="@+id/et_rf_power_fix_5"
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:hint="5G"
                        android:inputType="number"
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_write_rf_power_fix"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="fix rf power"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_rf_power_auto_down_2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="2G down"
                                android:inputType="number"
                                android:textColor="@android:color/white"
                                android:textColorHint="@android:color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=","
                                android:textColor="@android:color/white" />

                            <EditText
                                android:id="@+id/et_rf_power_auto_up_2"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="2G up"
                                android:inputType="number"
                                android:textColor="@android:color/white"
                                android:textColorHint="@android:color/white"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/et_rf_power_auto_down_5"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="5G down"
                                android:inputType="number"
                                android:textColor="@android:color/white"
                                android:textColorHint="@android:color/white"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=","
                                android:textColor="@android:color/white" />

                            <EditText
                                android:id="@+id/et_rf_power_auto_up_5"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="5G up"
                                android:inputType="number"
                                android:textColor="@android:color/white"
                                android:textColorHint="@android:color/white"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_write_rf_power_auto"
                        android:layout_width="68dp"
                        android:layout_height="96dp"
                        android:text="auto rf power"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/teal_700"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="rf soft switch"
                    android:textColor="@android:color/white" />

                <Button
                    android:id="@+id/btn_read_rf_config_2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="read soft switch RFConfig"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_power_2g"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:hint="Power2G"
                        android:inputType="number"
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_write_power_2g"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="write"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_power_5g"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:hint="Power5G"
                        android:inputType="number"
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_write_power_5g"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="write"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorPrimaryDark"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="rf hard/soft switch"
                    android:textColor="@android:color/white" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_is_soft_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Is Soft Switch"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_ap_mac"
                        android:layout_width="128dp"
                        android:layout_height="wrap_content"
                        android:hint="ApMac"
                        android:textColor="@android:color/white"
                        android:textColorHint="@android:color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_write_ap_mac"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="write"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_write_bangswitch_2g"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="2G"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_write_bangswitch_5g"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="5G"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_banghop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BandHop"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="up down ratio"
                        android:textColor="@android:color/white" />

                    <Spinner
                        android:id="@+id/sp_up_down_ratio"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="bandwidth"
                        android:textColor="@android:color/white" />

                    <Spinner
                        android:id="@+id/sp_bandwidth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_pair_device"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="pair device"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_calibrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="calibrate"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_switch_camera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="switch cam"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_read_version"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="read version"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_infrared_config"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="infrared config"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tv_log"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:textColor="#FF66FA45"
        android:textSize="16sp"
        tools:text="aaa" />
</LinearLayout>