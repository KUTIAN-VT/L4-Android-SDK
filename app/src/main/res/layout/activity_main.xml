<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    tools:context=".MainActivity">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:onClick="onClick"
        android:translationZ="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextureView
        android:id="@+id/texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:onClick="onClick"
        android:translationZ="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_bitrate_video"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:textColor="@android:color/holo_green_light"
        android:translationZ="1px"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="13 M/S" />

    <ScrollView
        android:id="@+id/sv_operate"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:translationZ="4px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_bitrate_video">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_shot"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/take_photo" />

            <Button
                android:id="@+id/btn_start_record"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/record_start" />

            <Button
                android:id="@+id/btn_stop_record"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/record_stop" />

            <Button
                android:id="@+id/btn_ff_info"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/ff_info" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_mock_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/white"
                android:text="@string/mock_video" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_mock_video2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/white"
                android:text="@string/mock_video2" />

            <Spinner
                android:id="@+id/sp_decode_mode"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginTop="4dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_hw_decode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/white"
                android:text="@string/hw_decode" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_aoa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/white"
                android:text="@string/fpv_communication" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sw_fpv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/white"
                android:text="@string/fpv_power" />

            <TextView
                android:id="@+id/tv_update_process"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@android:color/white"
                android:onClick="onClick"
                android:text="@string/ota_progress"
                android:textColor="@android:color/black"
                tools:text="50/66" />

            <Button
                android:id="@+id/btn_upgrade_gnd"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/ota_ground" />

            <Button
                android:id="@+id/btn_upgrade_sky"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/ota_sky" />

            <Button
                android:id="@+id/btn_upgrade_v3"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/ota_v3" />

            <Button
                android:id="@+id/btn_upgrade_v4"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/ota_v4" />

            <Button
                android:id="@+id/btn_pair_v4"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/pair_v4" />

            <Button
                android:id="@+id/btn_get_channel_info_v4"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/chaninfo_v4" />

            <Button
                android:id="@+id/btn_set_bandwidth_v4"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/bandwidth_v4" />

            <Button
                android:id="@+id/btn_config_v4"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/config_v4" />

            <Button
                android:id="@+id/btn_sysinfo_v4"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="@string/sysinfo_v4" />

            <Button
                android:id="@+id/btn_rtsp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="RTSP" />

            <Button
                android:id="@+id/btn_rtsp_multi"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="RTSP multi" />

            <Button
                android:id="@+id/btn_udp"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="UDP" />

            <Button
                android:id="@+id/btn_chuanyun"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="chuanyun" />

            <Button
                android:id="@+id/btn_mcu"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="MCU" />

            <Button
                android:id="@+id/btn_preference"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:onClick="onClick"
                android:text="Preference" />

            <TextView
                android:id="@+id/tv_sn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:textColor="#7CFC00"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_sys_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:textColor="#7CFC00"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:textColor="#7CFC00"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:translationZ="4px"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="#00000000"
            android:gravity="right"
            android:text="VT:  "
            android:textColor="#0000FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_VT"
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="#A0323232"
            android:gravity="left"
            android:text=" "
            android:textColor="#7CFC00"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="#00000000"
            android:gravity="right"
            android:text="Score: "
            android:textColor="#0000FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_VT_Score"
            android:layout_width="40dip"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="10dip"
            android:background="#A0323232"
            android:gravity="center"
            android:text=" "
            android:textColor="#7CFC00"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="30dip"
            android:layout_height="30dip"
            android:layout_gravity="center"
            android:layout_marginTop="4dip"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@mipmap/setting_hd_icon" />

        <ImageView
            android:id="@+id/image_VT_Score"
            android:layout_width="30dip"
            android:layout_height="30dip"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@mipmap/fpv_topbar_signal_level_0" />

        <TextView
            android:layout_width="1dip"
            android:layout_height="3dip"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="2dip"
            android:background="#A0323232"
            android:gravity="left" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="#00000000"
            android:gravity="right"
            android:text="RC:  "
            android:textColor="#0000FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_RC"
            android:layout_width="100dip"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="#A0323232"
            android:gravity="left"
            android:text=" "
            android:textColor="#7CFC00"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:background="#00000000"
            android:gravity="right"
            android:text="Score: "
            android:textColor="#0000FF"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_RC_Score"
            android:layout_width="40dip"
            android:layout_height="wrap_content"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="2dip"
            android:background="#A0323232"
            android:gravity="center"
            android:text=" "
            android:textColor="#7CFC00"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="30dip"
            android:layout_height="30dip"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@mipmap/setting_rc_icon" />

        <ImageView
            android:id="@+id/image_RC_Score"
            android:layout_width="30dip"
            android:layout_height="30dip"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="centerInside"
            android:src="@mipmap/fpv_topbar_signal_level_0" />

        <TextView
            android:id="@+id/tv_osd_locked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:background="#00000000"
            android:gravity="center"
            android:text="DisConnect"
            android:textColor="#FF0000"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_map"
        android:layout_width="@dimen/mini_map_width"
        android:layout_height="@dimen/mini_map_height"
        android:layout_marginRight="@dimen/mini_map_margin_right"
        android:layout_marginBottom="@dimen/mini_map_margin_bottom"
        android:background="@android:color/holo_orange_light"
        android:gravity="center"
        android:onClick="onClick"
        android:text="MAP"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:translationZ="3px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <SurfaceView
        android:id="@+id/surface2"
        android:layout_width="@dimen/video_2_width"
        android:layout_height="@dimen/video_2_height"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/widget_map"
        app:layout_constraintRight_toRightOf="@+id/widget_map" />

    <TextView
        android:id="@+id/tv_rx"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@android:color/holo_green_light"
        android:translationZ="1px"
        app:layout_constraintLeft_toRightOf="@+id/sv_operate"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_osd"
        tools:text="data" />
</androidx.constraintlayout.widget.ConstraintLayout>